@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Graduation_Project_ITI.Models.SellerSettingsVM
@{
      Layout = "~/Views/Shared/_SellerLayout.cshtml";
    ViewData["Title"] = "Seller Settings";

    string approvalText = Model.IsApproved switch
    {
        1 => "Approved",
        0 => "Rejected",
        _ => "Pending"
    };

    string approvalClass = Model.IsApproved switch
    {
        1 => "approved",
        0 => "rejected",
        _ => "pending"
    };
}

<div class="settings-page">

    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="settings-header">

        <div>
            <div class="page-badge">
                <i class="bi bi-gear-fill"></i>
                Seller Settings
            </div>

            <h1>Settings</h1>

            <p>
                Manage your profile, store and account preferences.
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="Analysis"
           class="back-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>


    <!-- ========================================= -->
    <!-- ALERTS -->
    <!-- ========================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert-box success">
            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["Success"]
            </span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-box error">
            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @TempData["Error"]
            </span>
        </div>
    }


    <div class="settings-layout">

        <!-- ========================================= -->
        <!-- SIDEBAR -->
        <!-- ========================================= -->

        <aside class="settings-sidebar">

            <div class="seller-mini-profile">

                <div class="seller-avatar">
                    @Model.ShopName.Substring(0, 1).ToUpper()
                </div>

                <div>
                    <strong>
                        @Model.ShopName
                    </strong>

                    <span>
                        Seller Account
                    </span>
                </div>

            </div>


            <nav class="settings-nav">

                <a href="#profile" class="active">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>

                <a href="#store">
                    <i class="bi bi-shop"></i>
                    <span>Store</span>
                </a>

                <a href="#security">
                    <i class="bi bi-shield-lock"></i>
                    <span>Security</span>
                </a>

                <a href="#account">
                    <i class="bi bi-info-circle"></i>
                    <span>Account</span>
                </a>

            </nav>

        </aside>


        <!-- ========================================= -->
        <!-- CONTENT -->
        <!-- ========================================= -->

        <main class="settings-content">


            <!-- ========================================= -->
            <!-- PROFILE -->
            <!-- ========================================= -->

            <section id="profile" class="settings-card">

                <div class="card-header">

                    <div class="card-icon purple">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        <h3>Profile Information</h3>

                        <p>
                            Update your personal information.
                        </p>
                    </div>

                </div>


                <form asp-action="UpdateProfile"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="SellerId" />

                    <input type="hidden"
                           asp-for="UserId" />

                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="Name">
                                Full Name
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-person"></i>

                                <input asp-for="Name"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="Name"
                                  class="validation"></span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Email">
                                Email Address
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <input asp-for="Email"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="Email"
                                  class="validation"></span>

                        </div>


                        <div class="form-group">

                            <label asp-for="PhoneNumber">
                                Phone Number
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-telephone"></i>

                                <input asp-for="PhoneNumber"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="PhoneNumber"
                                  class="validation"></span>

                        </div>

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="primary-btn">

                            <i class="bi bi-check-lg"></i>

                            Save Changes

                        </button>

                    </div>

                </form>

            </section>



            <!-- ========================================= -->
            <!-- STORE -->
            <!-- ========================================= -->

            <section id="store" class="settings-card">

                <div class="card-header">

                    <div class="card-icon blue">
                        <i class="bi bi-shop"></i>
                    </div>

                    <div>
                        <h3>Store Settings</h3>

                        <p>
                            Manage your marketplace store.
                        </p>
                    </div>

                </div>


                <form asp-action="UpdateStore"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="SellerId" />


                    <div class="form-group">

                        <label asp-for="ShopName">
                            Shop Name
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-shop"></i>

                            <input asp-for="ShopName"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="ShopName"
                              class="validation"></span>

                    </div>


                    <div class="store-status-box">

                        <div>

                            <strong>
                                Store Status
                            </strong>

                            <p>
                                Control whether customers can interact
                                with your store.
                            </p>

                        </div>

                        <div class="status-badge @(Model.StoreStatus ? "active" : "inactive")">

                            <span></span>

                            @(Model.StoreStatus
                                ? "Active"
                                : "Inactive")

                        </div>

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="primary-btn">

                            <i class="bi bi-check-lg"></i>

                            Update Store

                        </button>

                    </div>

                </form>

            </section>



            <!-- ========================================= -->
            <!-- SECURITY -->
            <!-- ========================================= -->

            <section id="security" class="settings-card">

                <div class="card-header">

                    <div class="card-icon orange">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div>
                        <h3>Security</h3>

                        <p>
                            Keep your seller account secure.
                        </p>
                    </div>

                </div>


                <form asp-action="ChangePassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="form-group">

                        <label asp-for="CurrentPassword">
                            Current Password
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-lock"></i>

                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Enter current password" />

                        </div>

                    </div>


                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="NewPassword">
                                New Password
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-key"></i>

                                <input asp-for="NewPassword"
                                       class="form-control"
                                       type="password"
                                       placeholder="Enter new password" />

                            </div>

                        </div>


                        <div class="form-group">

                            <label asp-for="ConfirmPassword">
                                Confirm Password
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-key-fill"></i>

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       type="password"
                                       placeholder="Confirm new password" />

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="validation"></span>

                        </div>

                    </div>


                    <div class="security-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Use a strong password containing letters,
                            numbers and special characters.
                        </span>

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="primary-btn orange-btn">

                            <i class="bi bi-shield-check"></i>

                            Change Password

                        </button>

                    </div>

                </form>

            </section>



            <!-- ========================================= -->
            <!-- ACCOUNT -->
            <!-- ========================================= -->

            <section id="account" class="settings-card">

                <div class="card-header">

                    <div class="card-icon green">
                        <i class="bi bi-info-circle"></i>
                    </div>

                    <div>
                        <h3>Account Information</h3>

                        <p>
                            Information about your seller account.
                        </p>
                    </div>

                </div>


                <div class="account-grid">

                    <div class="account-info">

                        <span>
                            Seller ID
                        </span>

                        <strong>
                            @Model.SellerId
                        </strong>

                    </div>


                    <div class="account-info">

                        <span>
                            Account Created
                        </span>

                        <strong>
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </strong>

                    </div>


                    <div class="account-info">

                        <span>
                            Approval Status
                        </span>

                        <strong class="approval @approvalClass">

                            <span></span>

                            @approvalText

                        </strong>

                    </div>


                    <div class="account-info">

                        <span>
                            Store Status
                        </span>

                        <strong class="approval @(Model.StoreStatus ? "approved" : "rejected")">

                            <span></span>

                            @(Model.StoreStatus
                                ? "Active"
                                : "Inactive")

                        </strong>

                    </div>

                </div>

            </section>

        </main>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.querySelectorAll('.settings-nav a')
            .forEach(link => {

                link.addEventListener('click', function () {

                    document
                        .querySelectorAll('.settings-nav a')
                        .forEach(x =>
                            x.classList.remove('active'));

                    this.classList.add('active');

                });

            });

    </script>
}


<style>

    * {
        box-sizing: border-box;
    }

    body {
        background: #f5f7fb;
        color: #172033;
    }

    .settings-page {
        width: 100%;
        min-height: 100vh;
        padding: 35px 45px 60px;
    }


    /* ================= HEADER ================= */

    .settings-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
    }

    .page-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .settings-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .settings-header p {
        margin: 7px 0 0;
        color: #7b8497;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 10px;
        background: white;
        color: #374151;
        text-decoration: none;
        border: 1px solid #e7eaf0;
        font-weight: 600;
        transition: .2s;
    }

    .back-btn:hover {
        color: #4f46e5;
        border-color: #cfd4ff;
        transform: translateY(-1px);
    }


    /* ================= LAYOUT ================= */

    .settings-layout {
        display: grid;
        grid-template-columns: 245px minmax(0, 1fr);
        gap: 25px;
        align-items: start;
    }


    /* ================= SIDEBAR ================= */

    .settings-sidebar {
        background: white;
        border: 1px solid #e8ebf1;
        border-radius: 18px;
        padding: 20px;
        position: sticky;
        top: 25px;
        box-shadow: 0 8px 30px rgba(25, 35, 60, .04);
    }

    .seller-mini-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f4;
        margin-bottom: 15px;
    }

    .seller-avatar {
        width: 45px;
        height: 45px;
        border-radius: 13px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        font-weight: 800;
    }

    .seller-mini-profile strong {
        display: block;
        font-size: 14px;
        max-width: 135px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .seller-mini-profile span {
        display: block;
        color: #8b94a7;
        font-size: 12px;
        margin-top: 3px;
    }

    .settings-nav {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .settings-nav a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 13px;
        border-radius: 10px;
        color: #687286;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: .2s;
    }

    .settings-nav a i {
        font-size: 17px;
    }

    .settings-nav a:hover {
        background: #f6f7fb;
        color: #4f46e5;
    }

    .settings-nav a.active {
        background: #eef2ff;
        color: #4f46e5;
    }


    /* ================= CONTENT ================= */

    .settings-content {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .settings-card {
        background: white;
        border: 1px solid #e8ebf1;
        border-radius: 18px;
        padding: 26px;
        box-shadow: 0 8px 30px rgba(25, 35, 60, .04);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 22px;
        margin-bottom: 22px;
        border-bottom: 1px solid #edf0f4;
    }

    .card-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 750;
    }

    .card-header p {
        margin: 4px 0 0;
        color: #8a93a6;
        font-size: 13px;
    }

    .card-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .card-icon.purple {
        background: #eef2ff;
        color: #4f46e5;
    }

    .card-icon.blue {
        background: #eaf6ff;
        color: #0284c7;
    }

    .card-icon.orange {
        background: #fff4e8;
        color: #ea580c;
    }

    .card-icon.green {
        background: #eafbf2;
        color: #16a34a;
    }


    /* ================= FORMS ================= */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9aa3b4;
        z-index: 2;
    }

    .form-control {
        width: 100%;
        height: 46px;
        border: 1px solid #dfe3eb;
        border-radius: 10px;
        padding: 0 14px 0 42px;
        outline: none;
        transition: .2s;
        font-size: 14px;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.10);
    }

    .validation {
        color: #dc2626;
        font-size: 12px;
        display: block;
        margin-top: 5px;
    }


    /* ================= BUTTONS ================= */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 10px;
    }

    .primary-btn {
        border: none;
        border-radius: 10px;
        padding: 11px 18px;
        background: #4f46e5;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .2s;
    }

    .primary-btn:hover {
        background: #4338ca;
        transform: translateY(-1px);
    }

    .orange-btn {
        background: #ea580c;
    }

    .orange-btn:hover {
        background: #c2410c;
    }


    /* ================= STORE ================= */

    .store-status-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        padding: 16px;
        margin-top: 5px;
    }

    .store-status-box strong {
        font-size: 14px;
    }

    .store-status-box p {
        margin: 4px 0 0;
        color: #8992a5;
        font-size: 12px;
    }

    .status-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge span,
    .approval span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-badge.active {
        color: #16a34a;
    }

    .status-badge.active span {
        background: #22c55e;
    }

    .status-badge.inactive {
        color: #dc2626;
    }

    .status-badge.inactive span {
        background: #ef4444;
    }


    /* ================= SECURITY ================= */

    .security-note {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 10px;
        font-size: 12px;
        margin-top: 3px;
    }


    /* ================= ACCOUNT ================= */

    .account-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .account-info {
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        padding: 16px;
    }

    .account-info > span {
        display: block;
        color: #8992a5;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .account-info > strong {
        display: block;
        font-size: 13px;
        word-break: break-all;
    }

    .approval {
        display: flex !important;
        align-items: center;
        gap: 7px;
    }

    .approval.approved {
        color: #16a34a;
    }

    .approval.approved span {
        background: #22c55e;
    }

    .approval.pending {
        color: #d97706;
    }

    .approval.pending span {
        background: #f59e0b;
    }

    .approval.rejected {
        color: #dc2626;
    }

    .approval.rejected span {
        background: #ef4444;
    }


    /* ================= ALERTS ================= */

    .alert-box {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        border-radius: 11px;
        margin-bottom: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .alert-box.success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .alert-box.error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 900px) {

        .settings-page {
            padding: 25px 20px 50px;
        }

        .settings-layout {
            grid-template-columns: 1fr;
        }

        .settings-sidebar {
            position: static;
        }

        .settings-nav {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }

        .settings-header {
            align-items: flex-start;
            gap: 20px;
            flex-direction: column;
        }

    }


    @@media (max-width: 600px) {

        .settings-page {
            padding: 20px 14px 40px;
        }

        .settings-card {
            padding: 20px;
        }

        .form-grid,
        .account-grid {
            grid-template-columns: 1fr;
        }

        .settings-nav {
            grid-template-columns: 1fr;
        }

        .store-status-box {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .settings-header h1 {
            font-size: 26px;
        }

    }

</style>
