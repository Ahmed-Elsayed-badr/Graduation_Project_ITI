@model IEnumerable<DAL.Product>

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
ViewData["Title"] = "Products";


var placeholder = Url.Content("~/images/placeholder.png");

var searchTerm = ViewBag.SearchTerm as string;
var sortAscending = ViewBag.SortAscending as bool?;

var products = Model?.ToList() ?? new List<DAL.Product>();

var totalProducts = products.Count;
var inStock = products.Count(p => p.AvailableQuantity > 5);
var lowStock = products.Count(p => p.AvailableQuantity > 0 && p.AvailableQuantity <= 5);
var outOfStock = products.Count(p => p.AvailableQuantity <= 0);

var hasFilters =
    !string.IsNullOrWhiteSpace(searchTerm) ||
    sortAscending.HasValue ||
    Context.Request.Query.ContainsKey("categoryId");

}

