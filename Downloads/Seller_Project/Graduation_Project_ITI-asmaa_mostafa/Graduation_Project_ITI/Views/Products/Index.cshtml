                <div class="stat-card">

                    <div class="stat-info">

                        <span>
                            Total Products
                        </span>

                        <strong>
                            @totalProducts
                        </strong>

                    </div>


                    <div class="stat-icon stat-purple">

                        <i class="bi bi-box-seam"></i>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-info">

                        <span>
                            In Stock
                        </span>

                        <strong>
                            @inStock
                        </strong>

                    </div>


                    <div class="stat-icon stat-green">

                        <i class="bi bi-check-circle"></i>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-info">

                        <span>
                            Low Stock
                        </span>

                        <strong>
                            @lowStock
                        </strong>

                    </div>


                    <div class="stat-icon stat-orange">

                        <i class="bi bi-exclamation-triangle"></i>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-info">

                        <span>
                            Out of Stock
                        </span>

                        <strong>
                            @outOfStock
                        </strong>

                    </div>


                    <div class="stat-icon stat-red">

                        <i class="bi bi-x-circle"></i>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 FILTERS
            ================================================== -->

            <div class="filter-box">


                <div class="filter-title">

                    <i class="bi bi-sliders"></i>

                    Filters

                </div>


                <form asp-action="Index"
                      method="get">

                    <div class="filter-grid">


                        <!-- SEARCH -->

                        <div>

                            <label class="filter-label">
                                Search
                            </label>


                            <div class="search-wrapper">

                                <i class="bi bi-search"></i>


                                <input type="text"
                                       name="searchTerm"
                                       value="@searchTerm"
                                       class="filter-input"
                                       placeholder="Search products..." />

                            </div>

                        </div>


                        <!-- CATEGORY -->

                        <div>

                            <label class="filter-label">
                                Category
                            </label>


                            <select name="categoryId"
                                    asp-items="@(ViewBag.Categories as SelectList)"
                                    class="filter-select">

                                <option value="">
                                    All Categories
                                </option>

                            </select>

                        </div>


                        <!-- SORT -->

                        <div>

                            <label class="filter-label">
                                Sort by Price
                            </label>


                            <select name="sortAscending"
                                    class="filter-select">

                                <option value="">
                                    Default
                                </option>


                                <option value="true"
                                        selected="@(sortAscending == true)">

                                    Low → High

                                </option>


                                <option value="false"
                                        selected="@(sortAscending == false)">

                                    High → Low

                                </option>

                            </select>

                        </div>


                        <!-- ACTIONS -->

                        <div class="filter-actions">

                            <button type="submit"
                                    class="filter-btn">

                                <i class="bi bi-search"></i>

                                Apply

                            </button>


                            @if (hasFilters)
                            {

                                <a asp-action="Index"
                                   class="clear-btn"
                                   title="Clear filters">

                                    <i class="bi bi-x-lg"></i>

                                </a>

                            }

                        </div>

                    </div>

                </form>

            </div>


            <!-- =================================================
                 PRODUCTS HEADER
            ================================================== -->

            <div class="products-header">

                <div>

                    <h3>
                        Your Products
                    </h3>

                    <span>
                        @totalProducts product(s) found
                    </span>

                </div>

            </div>


            <!-- =================================================
                 PRODUCTS
            ================================================== -->

            @if (!products.Any())
            {

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="bi bi-box"></i>

                    </div>


                    <h4>
                        No products found
                    </h4>


                    <p>
                        There are no products matching your current filters.
                    </p>


                    <a asp-action="Create"
                       class="add-product-btn">

                        <i class="bi bi-plus-lg"></i>

                        <span>
                            Add Your First Product
                        </span>

                    </a>

                </div>

            }
            else
            {

                <div class="products-grid">


                    @foreach (var product in products)
                    {

                        var imageUrl =
                            string.IsNullOrWhiteSpace(product.ImageUrl)
                                ? placeholder
                                : Url.Content(
                                    "~/" +
                                    product.ImageUrl.TrimStart('/')
                                  );


                        string stockClass;
                        string stockText;


                        if (product.AvailableQuantity <= 0)
                        {
                            stockClass = "stock-empty";
                            stockText = "Out of stock";
                        }
                        else if (product.AvailableQuantity <= 5)
                        {
                            stockClass = "stock-low";
                            stockText = "Low stock";
                        }
                        else
                        {
                            stockClass = "stock-good";
                            stockText = "In stock";
                        }


                        <article class="product-card">


                            <!-- IMAGE -->

                            <div class="product-image">

                                <img src="@imageUrl"
                                     alt="@product.Name"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='@placeholder';" />


                                <span class="stock-badge @stockClass">

                                    @stockText

                                </span>

                            </div>


                            <!-- BODY -->

                            <div class="product-body">


                                <div class="product-category">

                                    @(product.Category?.Name ?? "Uncategorized")

                                </div>


                                <h3 class="product-name"
                                    title="@product.Name">

                                    @product.Name

                                </h3>


                                <div class="product-meta">


                                    <div class="product-price">

                                        EGP @product.Price.ToString("N2")

                                    </div>


                                    <div class="product-stock">

                                        @product.AvailableQuantity units

                                    </div>

                                </div>


                                <!-- ACTIONS -->

                                <div class="product-actions">


                                    <a asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="product-action"
                                       title="View Details"
                                       aria-label="View Details">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="product-action edit"
                                       title="Edit Product"
                                       aria-label="Edit Product">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@product.Id"
                                       class="product-action delete"
                                       title="Delete Product"
                                       aria-label="Delete Product">

                                        <i class="bi bi-trash3"></i>

                                    </a>

                                </div>

                            </div>

                        </article>

                    }

                </div>

            }

        </div>

    </main>

</div>
```

</div>

<!-- =========================================================
     MOBILE SIDEBAR SCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const menuButton =
            document.getElementById("menuButton");

        const sidebar =
            document.getElementById("sellerSidebar");

        const overlay =
            document.getElementById("sidebarOverlay");


        function openSidebar() {

            if (!sidebar) return;

            sidebar.classList.add("open");

            overlay?.classList.add("show");

            document.body.style.overflow = "hidden";
        }


        function closeSidebar() {

            if (!sidebar) return;

            sidebar.classList.remove("open");

            overlay?.classList.remove("show");

            document.body.style.overflow = "";
        }


        menuButton?.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();

                if (sidebar.classList.contains("open")) {

                    closeSidebar();

                }
                else {

                    openSidebar();

                }

            }
        );


        overlay?.addEventListener(
            "click",
            closeSidebar
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    closeSidebar();

                }

            }
        );


        window.addEventListener(
            "resize",
            function () {

                if (window.innerWidth > 900) {

                    closeSidebar();

                }

            }
        );

    });

</script>
