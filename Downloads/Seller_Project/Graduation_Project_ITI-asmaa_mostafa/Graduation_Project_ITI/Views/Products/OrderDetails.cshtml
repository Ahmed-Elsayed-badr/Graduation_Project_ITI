@using Graduation_Project_ITI.Models

@model SellerOrderDetailsVM

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
ViewData["Title"] = "Order Details";


var statuses = new[]
{
    "Pending",
    "Confirmed",
    "Shipped",
    "Delivered",
    "Cancelled"
};

var totalItems = Model.Items.Sum(x => x.Quantity);

var orderTotal = Model.Items.Sum(x =>
    x.Quantity * x.UnitPrice);

var status = Model.Status?.ToLower() ?? "";

var overallStatusClass = status switch
{
    "pending" => "status-pending",
    "confirmed" => "status-confirmed",
    "shipped" => "status-shipped",
    "delivered" => "status-delivered",
    "cancelled" => "status-cancelled",
    _ => "status-default"
};

var customerName =
    string.IsNullOrWhiteSpace(Model.CustomerName)
        ? "Customer"
        : Model.CustomerName;

var customerInitial =
    customerName.Substring(0, 1).ToUpper();



}

<style>

    /* =========================================================
       PAGE
    ========================================================= */

    .order-details-page {
        width: 100%;
        min-height: 100vh;

        padding: 32px;

        background: #f6f8fb;

        box-sizing: border-box;
    }

    .order-details-container {
        width: 100%;
        max-width: 1750px;

        margin: 0 auto;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-bottom: 28px;
    }

    .order-header-left {
        display: flex;
        align-items: center;

        gap: 16px;
    }

    .order-header-icon {
        width: 54px;
        height: 54px;

        border-radius: 15px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #e8f0ff;
        color: #2563eb;

        font-size: 25px;
    }

    .order-header-info h1 {
        margin: 0;

        color: #111827;

        font-size: 27px;
        font-weight: 750;
    }

    .order-header-info p {
        margin: 5px 0 0;

        color: #6b7280;

        font-size: 14px;
    }


    /* =========================================================
       BACK BUTTON
    ========================================================= */

    .back-orders-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 16px;

        border: 1px solid #dce2ea;
        border-radius: 10px;

        background: #ffffff;

        color: #374151;

        text-decoration: none;

        font-size: 14px;
        font-weight: 600;

        transition: all .2s ease;
    }

    .back-orders-btn:hover {
        background: #f1f5f9;

        color: #111827;

        transform: translateY(-1px);
    }


    /* =========================================================
       SUMMARY CARDS
    ========================================================= */

    .order-summary-grid {
        display: grid;

        grid-template-columns:
            minmax(250px, 1.5fr)
            repeat(3, minmax(180px, 1fr));

        gap: 18px;

        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff;

        border: 1px solid #e7ebf0;
        border-radius: 16px;

        padding: 20px;

        box-shadow:
            0 4px 16px rgba(15, 23, 42, .04);
    }


    /* =========================================================
       CUSTOMER
    ========================================================= */

    .customer-card-content {
        display: flex;
        align-items: center;

        gap: 14px;
    }

    .customer-avatar {
        width: 48px;
        height: 48px;

        flex-shrink: 0;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #e8f0ff;
        color: #2563eb;

        font-size: 18px;
        font-weight: 700;
    }

    .summary-label {
        display: block;

        margin-bottom: 5px;

        color: #94a3b8;

        font-size: 12px;
        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: .5px;
    }

    .customer-name {
        display: block;

        color: #111827;

        font-size: 16px;
        font-weight: 700;
    }

    .customer-email {
        display: block;

        margin-top: 3px;

        color: #64748b;

        font-size: 13px;
    }


    /* =========================================================
       SUMMARY INFO
    ========================================================= */

    .summary-value {
        color: #111827;

        font-size: 19px;
        font-weight: 700;
    }

    .summary-subtext {
        margin-top: 4px;

        color: #94a3b8;

        font-size: 12px;
    }


    /* =========================================================
       STATUS
    ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 7px 12px;

        border-radius: 20px;

        font-size: 12px;
        font-weight: 700;

        text-transform: capitalize;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: currentColor;
    }

    .status-pending {
        background: #fff7df;
        color: #b45309;
    }

    .status-confirmed {
        background: #e8f0ff;
        color: #2563eb;
    }

    .status-shipped {
        background: #ede9fe;
        color: #7c3aed;
    }

    .status-delivered {
        background: #e7f8ef;
        color: #15803d;
    }

    .status-cancelled {
        background: #feecec;
        color: #dc2626;
    }

    .status-default {
        background: #f1f5f9;
        color: #475569;
    }


    /* =========================================================
       PRODUCTS CARD
    ========================================================= */

    .products-card {
        background: #ffffff;

        border: 1px solid #e7ebf0;

        border-radius: 18px;

        overflow: hidden;

        box-shadow:
            0 4px 18px rgba(15, 23, 42, .05);
    }

    .products-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 21px 24px;

        border-bottom: 1px solid #edf0f4;
    }

    .products-title {
        display: flex;
        align-items: center;

        gap: 10px;
    }

    .products-title i {
        font-size: 19px;

        color: #2563eb;
    }

    .products-title h2 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 700;
    }

    .items-count {
        padding: 5px 10px;

        border-radius: 20px;

        background: #f1f5f9;

        color: #475569;

        font-size: 12px;
        font-weight: 700;
    }


    /* =========================================================
       TABLE
    ========================================================= */

    .products-table-wrapper {
        overflow-x: auto;
    }

    .products-table {
        width: 100%;

        margin: 0;

        border-collapse: separate;
        border-spacing: 0;
    }

    .products-table thead th {
        padding: 15px 22px;

        background: #f8fafc;

        border-bottom: 1px solid #e8ebf0;

        color: #64748b;

        font-size: 11px;
        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: .5px;

        white-space: nowrap;
    }

    .products-table tbody td {
        padding: 19px 22px;

        border-bottom: 1px solid #f0f2f5;

        vertical-align: middle;

        color: #374151;

        font-size: 14px;
    }

    .products-table tbody tr {
        transition: background .2s ease;
    }

    .products-table tbody tr:hover {
        background: #fafbfc;
    }

    .products-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
       PRODUCT NAME
    ========================================================= */

    .product-cell {
        display: flex;
        align-items: center;

        gap: 12px;
    }

    .product-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        border-radius: 10px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #f1f5f9;
        color: #64748b;

        font-size: 18px;
    }

    .product-name {
        color: #111827;

        font-weight: 650;
    }


    /* =========================================================
       RATING
    ========================================================= */

    .rating-wrapper {
        min-width: 105px;
    }

    .rating-stars {
        white-space: nowrap;
    }

    .rating-stars i {
        font-size: 12px;
    }

    .rating-info {
        margin-top: 4px;

        color: #94a3b8;

        font-size: 11px;
    }

    .no-reviews {
        color: #94a3b8;

        font-size: 12px;
    }


    /* =========================================================
       QUANTITY
    ========================================================= */

    .quantity-badge {
        display: inline-flex;

        min-width: 34px;
        height: 30px;

        padding: 0 9px;

        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #f1f5f9;

        color: #475569;

        font-weight: 700;
    }


    /* =========================================================
       PRICE
    ========================================================= */

    .price {
        color: #374151;

        font-weight: 600;

        white-space: nowrap;
    }

    .total-price {
        color: #111827;

        font-weight: 750;

        white-space: nowrap;
    }

    .currency {
        color: #64748b;

        font-size: 11px;

        margin-right: 3px;
    }


    /* =========================================================
       UPDATE FORM
    ========================================================= */

    .status-form {
        display: flex;

        align-items: center;

        gap: 7px;

        min-width: 230px;
    }

    .status-select {
        min-width: 125px;

        border: 1px solid #dbe2ea;

        border-radius: 8px;

        padding: 7px 10px;

        background: #ffffff;

        color: #374151;

        font-size: 12px;

        outline: none;

        transition: border .2s ease,
                    box-shadow .2s ease;
    }

    .status-select:focus {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px rgba(37, 99, 235, .10);
    }

    .update-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 5px;

        padding: 7px 11px;

        border: none;

        border-radius: 8px;

        background: #2563eb;

        color: #ffffff;

        font-size: 12px;
        font-weight: 600;

        transition: all .2s ease;
    }

    .update-btn:hover {
        background: #1d4ed8;

        transform: translateY(-1px);
    }


    /* =========================================================
       TOTAL FOOTER
    ========================================================= */

    .products-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;

        padding: 20px 24px;

        background: #fafbfc;

        border-top: 1px solid #edf0f4;
    }

    .footer-total {
        text-align: right;
    }

    .footer-total-label {
        display: block;

        margin-bottom: 4px;

        color: #64748b;

        font-size: 12px;
    }

    .footer-total-value {
        color: #111827;

        font-size: 23px;
        font-weight: 750;
    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @@media (max-width: 1200px) {

        .order-summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    @@media (max-width: 850px) {

        .order-details-page {
            padding: 20px;
        }

        .order-header {
            align-items: flex-start;
        }

        .order-header-info h1 {
            font-size: 23px;
        }

    }


    @@media (max-width: 650px) {

        .order-details-page {
            padding: 15px;
        }

        .order-header {
            flex-direction: column;
            align-items: stretch;
        }

        .back-orders-btn {
            justify-content: center;
        }

        .order-summary-grid {
            grid-template-columns: 1fr;
        }

        .products-card-header {
            padding: 18px;
        }

        .products-table thead th,
        .products-table tbody td {
            padding: 13px 12px;
        }

        .status-form {
            min-width: 210px;
        }

    }

</style>

<div class="order-details-page">

```
<div class="order-details-container">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="order-header">

        <div class="order-header-left">

            <div class="order-header-icon">

                <i class="bi bi-receipt-cutoff"></i>

            </div>

            <div class="order-header-info">

                <h1>
                    Order #@Model.OrderId.ToString()[..8]
                </h1>

                <p>
                    Review customer information, products and order status
                </p>

            </div>

        </div>


        <a asp-action="Orders"
           class="back-orders-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Orders

        </a>

    </div>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <div class="order-summary-grid">


        <!-- CUSTOMER -->

        <div class="summary-card">

            <div class="customer-card-content">

                <div class="customer-avatar">

                    @customerInitial

                </div>

                <div>

                    <span class="summary-label">
                        Customer
                    </span>

                    <span class="customer-name">
                        @customerName
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                    {
                        <span class="customer-email">

                            <i class="bi bi-envelope me-1"></i>

                            @Model.CustomerEmail

                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- ORDER DATE -->

        <div class="summary-card">

            <span class="summary-label">
                Order Date
            </span>

            <div class="summary-value">

                <i class="bi bi-calendar3 me-1"></i>

                @Model.OrderDate.ToString("MMM dd, yyyy")

            </div>

            <div class="summary-subtext">

                @Model.OrderDate.ToString("HH:mm")

            </div>

        </div>


        <!-- ITEMS -->

        <div class="summary-card">

            <span class="summary-label">
                Items
            </span>

            <div class="summary-value">

                <i class="bi bi-box-seam me-1"></i>

                @totalItems

            </div>

            <div class="summary-subtext">
                Total quantity
            </div>

        </div>


        <!-- STATUS -->

        <div class="summary-card">

            <span class="summary-label">
                Order Status
            </span>

            <div class="mt-2">

                <span class="status-badge @overallStatusClass">

                    <span class="status-dot"></span>

                    @Model.Status

                </span>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCTS
    ====================================================== -->

    <div class="products-card">


        <div class="products-card-header">

            <div class="products-title">

                <i class="bi bi-box-seam"></i>

                <h2>
                    Order Items
                </h2>

                <span class="items-count">
                    @Model.Items.Count
                </span>

            </div>

        </div>


        <div class="products-table-wrapper">

            <table class="products-table">

                <thead>

                    <tr>

                        <th>Product</th>

                        <th>Rating</th>

                        <th>Quantity</th>

                        <th>Unit Price</th>

                        <th>Total</th>

                        <th>Status</th>

                        <th>Update Status</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model.Items)
                    {

                        var itemStatus =
                            item.Status?.ToLower() ?? "";

                        var itemStatusClass =
                            itemStatus switch
                            {
                                "pending" => "status-pending",
                                "confirmed" => "status-confirmed",
                                "shipped" => "status-shipped",
                                "delivered" => "status-delivered",
                                "cancelled" => "status-cancelled",
                                _ => "status-default"
                            };


                        <tr>


                            <!-- PRODUCT -->

                            <td>

                                <div class="product-cell">

                                    <div class="product-icon">

                                        <i class="bi bi-box"></i>

                                    </div>

                                    <span class="product-name">

                                        @item.ProductName

                                    </span>

                                </div>

                            </td>


                            <!-- RATING -->

                            <td>

                                @if (item.ReviewsCount > 0)
                                {

                                    <div class="rating-wrapper">

                                        <div class="rating-stars">

                                            @for (int i = 1; i <= 5; i++)
                                            {

                                                <i class="bi
                                                    @(i <= Math.Round(item.AverageRating)
                                                        ? "bi-star-fill text-warning"
                                                        : "bi-star text-muted")">
                                                </i>

                                            }

                                        </div>

                                        <div class="rating-info">

                                            @item.AverageRating.ToString("N1")

                                            <span>
                                                (@item.ReviewsCount reviews)
                                            </span>

                                        </div>

                                    </div>

                                }
                                else
                                {

                                    <span class="no-reviews">
                                        No reviews
                                    </span>

                                }

                            </td>


                            <!-- QUANTITY -->

                            <td>

                                <span class="quantity-badge">

                                    @item.Quantity

                                </span>

                            </td>


                            <!-- UNIT PRICE -->

                            <td>

                                <span class="price">

                                    <span class="currency">
                                        EGP
                                    </span>

                                    @item.UnitPrice.ToString("N2")

                                </span>

                            </td>


                            <!-- TOTAL -->

                            <td>

                                <span class="total-price">

                                    <span class="currency">
                                        EGP
                                    </span>

                                    @((item.Quantity * item.UnitPrice)
                                        .ToString("N2"))

                                </span>

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="status-badge @itemStatusClass">

                                    <span class="status-dot"></span>

                                    @item.Status

                                </span>

                            </td>


                            <!-- UPDATE -->

                            <td>

                                <form asp-controller="Products"
                                      asp-action="UpdateOrderItemStatus"
                                      method="post"
                                      class="status-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="orderItemId"
                                           value="@item.OrderItemId" />

                                    <input type="hidden"
                                           name="orderId"
                                           value="@Model.OrderId" />


                                    <select name="newStatus"
                                            class="status-select">

                                        @foreach (var s in statuses)
                                        {

                                            <option value="@s"
                                                    selected="@(s == item.Status)">

                                                @s

                                            </option>

                                        }

                                    </select>


                                    <button type="submit"
                                            class="update-btn">

                                        <i class="bi bi-check2"></i>

                                        Update

                                    </button>

                                </form>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>


        <!-- =================================================
             TOTAL
        ================================================== -->

        <div class="products-footer">

            <div class="footer-total">

                <span class="footer-total-label">
                    Seller Order Total
                </span>

                <span class="footer-total-value">

                    EGP @orderTotal.ToString("N2")

                </span>

            </div>

        </div>

    </div>

</div>

</div>
