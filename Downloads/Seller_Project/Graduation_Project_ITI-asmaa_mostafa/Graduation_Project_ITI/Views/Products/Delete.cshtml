@model DAL.Product

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
ViewData["Title"] = "Delete Product";


var placeholder = Url.Content("~/images/placeholder.png");


}

<style>

    /* =========================================
       Delete Product Page
       ========================================= */

    .delete-product-page {
        min-height: calc(100vh - 40px);
        padding: 35px 0 50px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .delete-product-container {
        width: 100%;
        max-width: 650px;
        margin: 0 auto;
    }


    /* =========================================
       Header
       ========================================= */

    .delete-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .warning-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 14px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fef2f2;
        color: #dc2626;
        font-size: 28px;
        border: 1px solid #fecaca;
    }

    .delete-header h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 750;
        color: #0f172a;
    }

    .delete-header p {
        margin: 7px 0 0;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================================
       Main Card
       ========================================= */

    .delete-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
    }


    /* =========================================
       Product Preview
       ========================================= */

    .product-preview {
        padding: 25px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
    }

    .product-preview-inner {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 15px;
    }

    .product-image-wrapper {
        width: 110px;
        height: 110px;
        flex-shrink: 0;
        border-radius: 13px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 8px;
    }

    .product-info {
        min-width: 0;
    }

    .product-category {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 7px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .product-name {
        font-size: 19px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 6px;
        word-break: break-word;
    }

    .product-price {
        color: #2563eb;
        font-size: 15px;
        font-weight: 700;
    }


    /* =========================================
       Warning Message
       ========================================= */

    .delete-content {
        padding: 28px;
    }

    .warning-box {
        display: flex;
        gap: 12px;
        padding: 15px;
        border-radius: 12px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        margin-bottom: 25px;
    }

    .warning-box i {
        font-size: 18px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .warning-box-content {
        font-size: 13px;
        line-height: 1.6;
    }

    .warning-box-content strong {
        display: block;
        margin-bottom: 2px;
        color: #7c2d12;
    }


    .confirmation-text {
        color: #475569;
        font-size: 14px;
        line-height: 1.7;
        text-align: center;
        margin-bottom: 25px;
    }

    .confirmation-text strong {
        color: #1e293b;
    }


    /* =========================================
       Actions
       ========================================= */

    .delete-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .delete-actions .btn {
        min-height: 45px;
        min-width: 155px;
        padding: 0 20px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-delete {
        color: #ffffff;
        background: #dc2626;
        border: 1px solid #dc2626;
    }

    .btn-delete:hover {
        background: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-cancel {
        color: #475569;
        background: #ffffff;
        border: 1px solid #dbe2ea;
    }

    .btn-cancel:hover {
        color: #1e293b;
        background: #f8fafc;
        transform: translateY(-1px);
    }


    /* =========================================
       Footer
       ========================================= */

    .delete-footer {
        padding: 15px 28px;
        background: #fafafa;
        border-top: 1px solid #e5e7eb;
        text-align: center;
        color: #94a3b8;
        font-size: 12px;
    }


    /* =========================================
       Responsive
       ========================================= */

    @@media (max-width: 575.98px) {

        .delete-product-page {
            padding: 20px 12px 35px;
        }

        .delete-header h1 {
            font-size: 23px;
        }

        .warning-icon {
            width: 55px;
            height: 55px;
            font-size: 24px;
        }

        .product-preview {
            padding: 18px;
        }

        .product-preview-inner {
            align-items: flex-start;
            gap: 14px;
        }

        .product-image-wrapper {
            width: 85px;
            height: 85px;
        }

        .product-name {
            font-size: 16px;
        }

        .delete-content {
            padding: 22px 18px;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .delete-actions .btn {
            width: 100%;
        }

        .delete-footer {
            padding: 14px 18px;
        }
    }

</style>

<div class="delete-product-page">

<div class="delete-product-container">


    <!-- =====================================
         Header
         ====================================== -->

    <div class="delete-header">

        <div class="warning-icon">
            <i class="bi bi-trash3"></i>
        </div>

        <h1>
            Delete Product
        </h1>

        <p>
            Please review the product before confirming deletion.
        </p>

    </div>


    <!-- =====================================
         Main Card
         ====================================== -->

    <div class="delete-card">


        <!-- =================================
             Product Preview
             ================================= -->

        <div class="product-preview">

            <div class="product-preview-inner">

                <div class="product-image-wrapper">

                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="product-image"
                         onerror="this.onerror=null;this.src='@placeholder';" />

                </div>


                <div class="product-info">

                    <div class="product-category">

                        <i class="bi bi-tag"></i>

                        @(Model.Category?.Name ?? "Uncategorized")

                    </div>


                    <h2 class="product-name">
                        @Model.Name
                    </h2>


                    <div class="product-price">

                        @Model.Price.ToString("N2") EGP

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================
             Confirmation Content
             ================================= -->

        <div class="delete-content">


            <!-- Warning -->

            <div class="warning-box">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div class="warning-box-content">

                    <strong>
                        This action cannot be undone.
                    </strong>

                    Deleting this product will permanently remove
                    it from your product list.

                </div>

            </div>


            <!-- Confirmation -->

            <p class="confirmation-text">

                Are you sure you want to delete

                <strong>
                    "@Model.Name"
                </strong>

                ?

            </p>


            <!-- Actions -->

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />


                <div class="delete-actions">

                    <a asp-action="Index"
                       class="btn btn-cancel">

                        <i class="bi bi-arrow-left"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-delete">

                        <i class="bi bi-trash3"></i>

                        Yes, Delete Product

                    </button>

                </div>

            </form>

        </div>


        <!-- =================================
             Footer
             ================================= -->

        <div class="delete-footer">

            <i class="bi bi-shield-check"></i>

            Make sure you want to permanently remove this product.

        </div>

    </div>

</div>


</div>
