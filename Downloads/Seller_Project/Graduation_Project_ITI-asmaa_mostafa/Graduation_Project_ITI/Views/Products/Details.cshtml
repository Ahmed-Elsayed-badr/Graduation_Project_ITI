@model DAL.Product

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
ViewData["Title"] = Model.Name;


var placeholder = Url.Content("~/images/placeholder.png");

var isInStock = Model.AvailableQuantity > 0;

var stockClass = isInStock ? "stock-available" : "stock-out";

var stockIcon = isInStock
    ? "bi-check-circle-fill"
    : "bi-x-circle-fill";

var stockText = isInStock
    ? $"{Model.AvailableQuantity} items available"
    : "Out of stock";


}

<style>
    /* =========================
       Product Details Page
       ========================= */

    .product-details-page {
        min-height: calc(100vh - 40px);
        padding: 30px 0 50px;
    }

    .product-details-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }

    /* =========================
       Header
       ========================= */

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        gap: 20px;
    }

    .details-title-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .details-title-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef4ff;
        color: #2563eb;
        font-size: 22px;
    }

    .details-title h1 {
        font-size: 25px;
        font-weight: 700;
        margin: 0;
        color: #1e293b;
    }

    .details-title p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    /* =========================
       Main Card
       ========================= */

    .product-details-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.07);
    }

    /* =========================
       Product Image
       ========================= */

    .product-image-wrapper {
        min-height: 560px;
        height: 100%;
        background: #f8fafc;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px;
        border-right: 1px solid #eef2f7;
    }

    .product-image-wrapper::before {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: #eef4ff;
        opacity: 0.7;
    }

    .product-image {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 450px;
        height: 470px;
        object-fit: contain;
        border-radius: 16px;
        transition: transform 0.3s ease;
    }

    .product-image:hover {
        transform: scale(1.03);
    }

    /* =========================
       Product Content
       ========================= */

    .product-info {
        padding: 42px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .product-category {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .product-name {
        font-size: 34px;
        line-height: 1.2;
        font-weight: 750;
        color: #0f172a;
        margin: 0 0 18px;
    }

    .product-price {
        font-size: 30px;
        font-weight: 750;
        color: #2563eb;
        margin-bottom: 25px;
    }

    .price-currency {
        font-size: 16px;
        font-weight: 600;
        color: #64748b;
        margin-left: 5px;
    }

    /* =========================
       Divider
       ========================= */

    .product-divider {
        border: 0;
        border-top: 1px solid #e5e7eb;
        margin: 0 0 24px;
    }

    /* =========================
       Description
       ========================= */

    .section-label {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        margin-bottom: 8px;
    }

    .product-description {
        color: #475569;
        font-size: 15px;
        line-height: 1.8;
        margin-bottom: 25px;
        min-height: 60px;
    }

    /* =========================
       Product Meta
       ========================= */

    .product-meta {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 28px;
    }

    .meta-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 15px;
    }

    .meta-label {
        display: block;
        font-size: 12px;
        color: #64748b;
        margin-bottom: 5px;
    }

    .meta-value {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
    }

    /* =========================
       Stock Status
       ========================= */

    .stock-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 9px 13px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
    }

    .stock-available {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .stock-out {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    /* =========================
       Actions
       ========================= */

    .product-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: auto;
        padding-top: 10px;
    }

    .product-actions .btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-back {
        color: #475569;
        background: #ffffff;
        border: 1px solid #dbe2ea;
    }

    .btn-back:hover {
        background: #f8fafc;
        color: #1e293b;
        transform: translateY(-1px);
    }

    .btn-edit {
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    .btn-edit:hover {
        background: #fef3c7;
        color: #92400e;
        transform: translateY(-1px);
    }

    .btn-delete {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .btn-delete:hover {
        background: #fee2e2;
        color: #b91c1c;
        transform: translateY(-1px);
    }

    /* =========================
       Responsive
       ========================= */

    @@media (max-width: 991.98px) {

        .product-image-wrapper {
            min-height: 420px;
            border-right: 0;
            border-bottom: 1px solid #eef2f7;
        }

        .product-image {
            height: 350px;
        }

        .product-info {
            padding: 30px;
        }

        .product-name {
            font-size: 28px;
        }
    }

    @@media (max-width: 575.98px) {

        .product-details-page {
            padding: 20px 12px 35px;
        }

        .details-header {
            align-items: flex-start;
        }

        .details-title h1 {
            font-size: 20px;
        }

        .details-title p {
            font-size: 12px;
        }

        .details-title-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            font-size: 18px;
        }

        .product-image-wrapper {
            min-height: 320px;
            padding: 25px;
        }

        .product-image {
            height: 270px;
        }

        .product-info {
            padding: 24px 20px;
        }

        .product-name {
            font-size: 24px;
        }

        .product-price {
            font-size: 25px;
        }

        .product-meta {
            grid-template-columns: 1fr;
        }

        .product-actions {
            flex-direction: column;
        }

        .product-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="product-details-page">


<div class="product-details-container">

    <!-- Header -->
    <div class="details-header">

        <div class="details-title-wrapper">

            <div class="details-title-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div class="details-title">
                <h1>Product Details</h1>
                <p>View complete information about this product</p>
            </div>

        </div>

    </div>


    <!-- Product Card -->
    <div class="product-details-card">

        <div class="row g-0">

            <!-- Product Image -->
            <div class="col-lg-6">

                <div class="product-image-wrapper">

                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="product-image"
                         onerror="this.onerror=null;this.src='@placeholder';" />

                </div>

            </div>


            <!-- Product Information -->
            <div class="col-lg-6">

                <div class="product-info">

                    <!-- Category -->
                    <div class="product-category">

                        <i class="bi bi-tag"></i>

                        <span>
                            @(Model.Category?.Name ?? "Uncategorized")
                        </span>

                    </div>


                    <!-- Product Name -->
                    <h2 class="product-name">
                        @Model.Name
                    </h2>


                    <!-- Price -->
                    <div class="product-price">

                        @Model.Price.ToString("N2")

                        <span class="price-currency">
                            EGP
                        </span>

                    </div>


                    <hr class="product-divider" />


                    <!-- Description -->
                    <div>

                        <div class="section-label">
                            Description
                        </div>

                        <p class="product-description">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description available for this product."
                                : Model.Description)
                        </p>

                    </div>


                    <!-- Product Information -->
                    <div class="product-meta">

                        <div class="meta-box">

                            <span class="meta-label">
                                Category
                            </span>

                            <span class="meta-value">
                                @(Model.Category?.Name ?? "Uncategorized")
                            </span>

                        </div>


                        <div class="meta-box">

                            <span class="meta-label">
                                Product ID
                            </span>

                            <span class="meta-value">
                                @Model.Id.ToString()[..8]
                            </span>

                        </div>

                    </div>


                    <!-- Stock -->
                    <div class="mb-4">

                        <div class="section-label">
                            Availability
                        </div>

                        <span class="stock-status @stockClass">

                            <i class="bi @stockIcon"></i>

                            @stockText

                        </span>

                    </div>


                    <!-- Actions -->
                    <div class="product-actions">

                        <a asp-action="Index"
                           class="btn btn-back">

                            <i class="bi bi-arrow-left"></i>

                            Back to Products

                        </a>


                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-edit">

                            <i class="bi bi-pencil-square"></i>

                            Edit Product

                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-delete">

                            <i class="bi bi-trash3"></i>

                            Delete Product

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


</div>
