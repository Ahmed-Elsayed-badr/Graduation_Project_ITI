@model List<SellerOrderListVM>

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
ViewData["Title"] = "My Orders";

var totalOrders = Model.Count;
var pendingOrders = Model.Count(x => x.Status?.ToLower() == "pending");
var completedOrders = Model.Count(x =>
    x.Status?.ToLower() == "delivered" ||
    x.Status?.ToLower() == "completed");

var totalRevenue = Model.Sum(x => x.Total);

}

<style>

    /* ==============================
       PAGE
    ============================== */

    .orders-page {
        width: 100%;
        min-height: 100vh;
        padding: 32px;
        background: #f6f8fb;
        box-sizing: border-box;
    }

    .orders-container {
        width: 100%;
        max-width: 1700px;
        margin: 0 auto;
    }


    /* ==============================
       HEADER
    ============================== */

    .orders-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .orders-title-wrapper {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .orders-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #e8f0ff;
        color: #2563eb;

        font-size: 24px;
    }

    .orders-title h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #111827;
    }

    .orders-title p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 10px 16px;

        border: 1px solid #dbe1ea;
        border-radius: 10px;

        background: white;
        color: #374151;

        text-decoration: none;
        font-size: 14px;
        font-weight: 600;

        transition: all .2s ease;
    }

    .back-btn:hover {
        background: #f3f4f6;
        color: #111827;
        transform: translateY(-1px);
    }


    /* ==============================
       STAT CARDS
    ============================== */

    .orders-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;

        margin-bottom: 28px;
    }

    .stat-card {
        background: white;

        border: 1px solid #e8ebf0;
        border-radius: 16px;

        padding: 20px;

        display: flex;
        align-items: center;
        gap: 15px;

        box-shadow: 0 3px 12px rgba(15, 23, 42, .04);

        transition: transform .2s ease,
                    box-shadow .2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(15, 23, 42, .08);
    }

    .stat-icon {
        width: 48px;
        height: 48px;

        border-radius: 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 21px;
    }

    .stat-icon.orders {
        background: #e8f0ff;
        color: #2563eb;
    }

    .stat-icon.pending {
        background: #fff7df;
        color: #d97706;
    }

    .stat-icon.completed {
        background: #e7f8ef;
        color: #16a34a;
    }

    .stat-icon.revenue {
        background: #f1eaff;
        color: #7c3aed;
    }

    .stat-info span {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 4px;
    }

    .stat-info strong {
        display: block;
        font-size: 23px;
        font-weight: 700;
        color: #111827;
    }


    /* ==============================
       ORDERS CARD
       ============================== */

    .orders-card {
        background: white;

        border: 1px solid #e7eaf0;
        border-radius: 18px;

        overflow: hidden;

        box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
    }

    .orders-card-header {
        padding: 22px 24px;

        display: flex;
        justify-content: space-between;
        align-items: center;

        border-bottom: 1px solid #edf0f4;
    }

    .orders-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .orders-card-title h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #111827;
    }

    .orders-count {
        padding: 5px 10px;

        border-radius: 20px;

        background: #f1f5f9;
        color: #475569;

        font-size: 12px;
        font-weight: 700;
    }


    /* ==============================
       TABLE
       ============================== */

    .orders-table-wrapper {
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .orders-table thead th {
        padding: 15px 22px;

        background: #f8fafc;

        border-bottom: 1px solid #e8ebf0;

        color: #64748b;

        font-size: 12px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .4px;

        white-space: nowrap;
    }

    .orders-table tbody td {
        padding: 18px 22px;

        border-bottom: 1px solid #f0f2f5;

        vertical-align: middle;

        color: #374151;
        font-size: 14px;
    }

    .orders-table tbody tr {
        transition: background .2s ease;
    }

    .orders-table tbody tr:hover {
        background: #fafbfc;
    }

    .orders-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* ==============================
       ORDER ID
       ============================== */

    .order-id {
        display: inline-flex;
        align-items: center;

        padding: 6px 10px;

        border-radius: 8px;

        background: #f1f5f9;

        color: #334155;

        font-family: monospace;

        font-size: 12px;
        font-weight: 700;
    }


    /* ==============================
       CUSTOMER
       ============================== */

    .customer-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .customer-avatar {
        width: 38px;
        height: 38px;

        flex-shrink: 0;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #e8f0ff;
        color: #2563eb;

        font-size: 15px;
        font-weight: 700;
    }

    .customer-name {
        font-weight: 600;
        color: #1f2937;
    }


    /* ==============================
       DATE
       ============================== */

    .date-cell {
        display: flex;
        align-items: center;
        gap: 7px;

        color: #64748b;
    }

    .date-cell i {
        color: #94a3b8;
    }


    /* ==============================
       ITEMS
       ============================== */

    .items-badge {
        display: inline-flex;

        min-width: 32px;
        height: 30px;

        padding: 0 9px;

        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #f1f5f9;
        color: #475569;

        font-weight: 700;
        font-size: 13px;
    }


    /* ==============================
       TOTAL
       ============================== */

    .order-total {
        font-weight: 700;
        color: #111827;

        white-space: nowrap;
    }

    .currency {
        color: #64748b;
        font-size: 12px;
        margin-right: 3px;
        font-weight: 600;
    }


    /* ==============================
       STATUS
       ============================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 7px 11px;

        border-radius: 20px;

        font-size: 12px;
        font-weight: 700;

        text-transform: capitalize;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-pending {
        background: #fff7df;
        color: #b45309;
    }

    .status-confirmed {
        background: #e8f0ff;
        color: #2563eb;
    }

    .status-shipped {
        background: #ede9fe;
        color: #7c3aed;
    }

    .status-delivered,
    .status-completed {
        background: #e7f8ef;
        color: #15803d;
    }

    .status-cancelled {
        background: #feecec;
        color: #dc2626;
    }

    .status-default {
        background: #f1f5f9;
        color: #475569;
    }


    /* ==============================
       VIEW BUTTON
       ============================== */

    .view-order-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        padding: 8px 13px;

        border: 1px solid #dbe3ef;
        border-radius: 9px;

        background: white;
        color: #2563eb;

        text-decoration: none;

        font-size: 13px;
        font-weight: 600;

        transition: all .2s ease;
    }

    .view-order-btn:hover {
        background: #2563eb;
        border-color: #2563eb;
        color: white;

        transform: translateY(-1px);
    }


    /* ==============================
       EMPTY STATE
       ============================== */

    .empty-state {
        padding: 75px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 75px;
        height: 75px;

        margin: 0 auto 18px;

        border-radius: 20px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #eef2f7;
        color: #94a3b8;

        font-size: 32px;
    }

    .empty-state h3 {
        margin-bottom: 7px;

        color: #1f2937;

        font-size: 19px;
        font-weight: 700;
    }

    .empty-state p {
        margin: 0;

        color: #94a3b8;

        font-size: 14px;
    }


    /* ==============================
       MOBILE
       ============================== */

    @@media (max-width: 1200px) {

        .orders-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 850px) {

        .orders-page {
            padding: 20px;
        }

        .orders-header {
            align-items: flex-start;
        }

        .orders-title h1 {
            font-size: 23px;
        }

        .orders-table thead th,
        .orders-table tbody td {
            padding: 14px 15px;
        }
    }


    @@media (max-width: 600px) {

        .orders-page {
            padding: 15px;
        }

        .orders-header {
            flex-direction: column;
            align-items: stretch;
        }

        .back-btn {
            justify-content: center;
        }

        .orders-stats {
            grid-template-columns: 1fr;
        }

        .orders-card-header {
            padding: 18px;
        }

        .orders-table thead th,
        .orders-table tbody td {
            padding: 13px 12px;
        }
    }

</style>

<div class="orders-page">

<div class="orders-container">


    <!-- =========================
         HEADER
    ========================== -->

    <div class="orders-header">

        <div class="orders-title-wrapper">

            <div class="orders-icon">
                <i class="bi bi-bag-check"></i>
            </div>

            <div class="orders-title">

                <h1>My Orders</h1>

                <p>
                    Manage and track orders containing your products
                </p>

            </div>

        </div>


        <a asp-controller="Products"
           asp-action="Index"
           class="back-btn">

            <i class="bi bi-arrow-left"></i>

            Back to Products

        </a>

    </div>


    <!-- =========================
         STATISTICS
    ========================== -->

    <div class="orders-stats">


        <!-- Total Orders -->

        <div class="stat-card">

            <div class="stat-icon orders">
                <i class="bi bi-bag"></i>
            </div>

            <div class="stat-info">

                <span>Total Orders</span>

                <strong>
                    @totalOrders
                </strong>

            </div>

        </div>


        <!-- Pending -->

        <div class="stat-card">

            <div class="stat-icon pending">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div class="stat-info">

                <span>Pending</span>

                <strong>
                    @pendingOrders
                </strong>

            </div>

        </div>


        <!-- Completed -->

        <div class="stat-card">

            <div class="stat-icon completed">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="stat-info">

                <span>Completed</span>

                <strong>
                    @completedOrders
                </strong>

            </div>

        </div>


        <!-- Revenue -->

        <div class="stat-card">

            <div class="stat-icon revenue">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div class="stat-info">

                <span>Total Revenue</span>

                <strong>
                    EGP @totalRevenue.ToString("N0")
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================
         ORDERS TABLE
    ========================== -->

    <div class="orders-card">


        <div class="orders-card-header">

            <div class="orders-card-title">

                <i class="bi bi-list-ul text-primary"></i>

                <h2>Recent Orders</h2>

                <span class="orders-count">
                    @totalOrders
                </span>

            </div>

        </div>


        @if (!Model.Any())
        {

            <!-- EMPTY STATE -->

            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-bag-x"></i>
                </div>

                <h3>No Orders Yet</h3>

                <p>
                    You don't have any orders containing your products yet.
                </p>

            </div>

        }
        else
        {

            <div class="orders-table-wrapper">

                <table class="orders-table">

                    <thead>

                        <tr>

                            <th>Order ID</th>

                            <th>Customer</th>

                            <th>Date</th>

                            <th>Items</th>

                            <th>Total</th>

                            <th>Status</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var order in Model)
                        {

                            var status = order.Status?.ToLower() ?? "";

                            var statusClass = status switch
                            {
                                "pending" => "status-pending",
                                "confirmed" => "status-confirmed",
                                "shipped" => "status-shipped",
                                "delivered" => "status-delivered",
                                "completed" => "status-completed",
                                "cancelled" => "status-cancelled",
                                _ => "status-default"
                            };


                            var customerName =
                                string.IsNullOrWhiteSpace(order.CustomerName)
                                ? "Customer"
                                : order.CustomerName;

                            var customerInitial =
                                customerName.Substring(0, 1).ToUpper();


                            <tr>


                                <!-- ORDER ID -->

                                <td>

                                    <span class="order-id">

                                        #@order.OrderId
                                            .ToString()[..8]

                                    </span>

                                </td>


                                <!-- CUSTOMER -->

                                <td>

                                    <div class="customer-cell">

                                        <div class="customer-avatar">

                                            @customerInitial

                                        </div>

                                        <span class="customer-name">

                                            @customerName

                                        </span>

                                    </div>

                                </td>


                                <!-- DATE -->

                                <td>

                                    <div class="date-cell">

                                        <i class="bi bi-calendar3"></i>

                                        @order.OrderDate
                                            .ToString("MMM dd, yyyy")

                                    </div>

                                </td>


                                <!-- ITEMS -->

                                <td>

                                    <span class="items-badge">

                                        @order.ItemsCount

                                    </span>

                                </td>


                                <!-- TOTAL -->

                                <td>

                                    <span class="order-total">

                                        <span class="currency">
                                            EGP
                                        </span>

                                        @order.Total.ToString("N2")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="status-badge @statusClass">

                                        <span class="status-dot"></span>

                                        @order.Status

                                    </span>

                                </td>


                                <!-- ACTION -->

                                <td class="text-end">

                                    <a asp-action="OrderDetails"
                                       asp-route-id="@order.OrderId"
                                       class="view-order-btn">

                                        <i class="bi bi-eye"></i>

                                        View Details

                                    </a>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</div>


</div>
