@model Graduation_Project_ITI.ViewModels.ProductViewModel

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
ViewData["Title"] = "Edit Product";

var placeholder = Url.Content("~/images/placeholder.png");


}

<style>

    /* =========================================
       Edit Product Page
       ========================================= */

    .edit-product-page {
        min-height: calc(100vh - 40px);
        padding: 30px 0 50px;
    }

    .edit-product-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }


    /* =========================================
       Page Header
       ========================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #fff7ed;
        color: #f59e0b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 25px;
        font-weight: 750;
        color: #0f172a;
    }

    .page-header p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================================
       Main Card
       ========================================= */

    .edit-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.07);
    }

    .edit-card-body {
        padding: 38px;
    }


    /* =========================================
       Section
       ========================================= */

    .form-section {
        margin-bottom: 30px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 18px;
    }

    .section-title i {
        color: #2563eb;
    }


    /* =========================================
       Form
       ========================================= */

    .form-label {
        color: #334155;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
    }

    .input-group .form-control {
        border-radius: 10px 0 0 10px;
    }

    .input-group-text {
        border: 1px solid #dbe2ea;
        background: #f8fafc;
        color: #64748b;
        font-weight: 600;
        border-radius: 0 10px 10px 0;
    }


    /* =========================================
       Image Section
       ========================================= */

    .image-card {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
    }

    .image-card-header {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;
    }

    .image-card-header i {
        color: #2563eb;
    }

    .image-card-header span {
        font-size: 14px;
        font-weight: 700;
        color: #334155;
    }

    .image-preview-container {
        width: 100%;
        height: 290px;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 14px;
    }

    .image-preview {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 12px;
    }

    .no-image {
        text-align: center;
        color: #94a3b8;
    }

    .no-image i {
        display: block;
        font-size: 42px;
        margin-bottom: 8px;
    }

    .file-input {
        background: #ffffff;
    }

    .image-help {
        display: block;
        margin-top: 8px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================
       Validation
       ========================================= */

    .validation-summary {
        border-radius: 12px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #b91c1c;
        padding: 12px 15px;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }


    /* =========================================
       Footer
       ========================================= */

    .form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding-top: 25px;
        border-top: 1px solid #e5e7eb;
    }

    .footer-info {
        color: #64748b;
        font-size: 12px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
    }

    .form-actions .btn {
        min-height: 44px;
        padding: 0 20px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-save {
        background: #f59e0b;
        border: 1px solid #f59e0b;
        color: #ffffff;
    }

    .btn-save:hover {
        background: #d97706;
        border-color: #d97706;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-cancel {
        background: #ffffff;
        border: 1px solid #dbe2ea;
        color: #475569;
    }

    .btn-cancel:hover {
        background: #f8fafc;
        color: #1e293b;
    }


    /* =========================================
       Responsive
       ========================================= */

    @@media (max-width: 991.98px) {

        .edit-card-body {
            padding: 28px;
        }

        .image-card {
            margin-top: 10px;
        }

        .image-preview-container {
            height: 320px;
        }
    }


    @@media (max-width: 575.98px) {

        .edit-product-page {
            padding: 20px 12px 35px;
        }

        .page-header {
            align-items: flex-start;
        }

        .page-icon {
            width: 42px;
            height: 42px;
            font-size: 18px;
        }

        .page-header h1 {
            font-size: 21px;
        }

        .page-header p {
            font-size: 12px;
        }

        .edit-card-body {
            padding: 22px 18px;
        }

        .image-preview-container {
            height: 250px;
        }

        .form-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .footer-info {
            text-align: center;
        }

        .form-actions {
            width: 100%;
        }

        .form-actions .btn {
            flex: 1;
        }
    }

</style>

<div class="edit-product-page">


<div class="edit-product-container">


    <!-- =====================================
         Page Header
         ====================================== -->

    <div class="page-header">

        <div class="page-header-left">

            <div class="page-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h1>Edit Product</h1>

                <p>
                    Update your product information and manage its image
                </p>
            </div>

        </div>

    </div>


    <!-- =====================================
         Main Card
         ====================================== -->

    <div class="edit-card">

        <div class="edit-card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>

                <!-- Hidden Fields -->

                <input type="hidden" asp-for="Id" />

                <input type="hidden" asp-for="SellerId" />

                <input type="hidden" asp-for="ExistingImageUrl" />


                <!-- Validation -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>


                <div class="row g-4">


                    <!-- =================================
                         Product Information
                         ================================= -->

                    <div class="col-lg-7">

                        <div class="form-section">

                            <div class="section-title">

                                <i class="bi bi-box-seam"></i>

                                <span>
                                    Product Information
                                </span>

                            </div>


                            <!-- Product Name -->

                            <div class="mb-3">

                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter product name" />

                                <span asp-validation-for="Name"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Description -->

                            <div class="mb-3">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Describe your product...">
                                </textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Price / Quantity -->

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="Price"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <input asp-for="Price"
                                               class="form-control"
                                               placeholder="0.00" />

                                        <span class="input-group-text">
                                            EGP
                                        </span>

                                    </div>

                                    <span asp-validation-for="Price"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="AvailableQuantity"
                                           class="form-label fw-semibold">
                                    </label>

                                    <input asp-for="AvailableQuantity"
                                           class="form-control"
                                           placeholder="Available quantity" />

                                    <span asp-validation-for="AvailableQuantity"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>


                            <!-- Category -->

                            <div class="mt-3">

                                <label asp-for="CategoryId"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        class="form-select">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         Product Image
                         ================================= -->

                    <div class="col-lg-5">

                        <div class="image-card">

                            <div class="image-card-header">

                                <i class="bi bi-image"></i>

                                <span>
                                    Product Image
                                </span>

                            </div>


                            <!-- Image Preview -->

                            <div class="image-preview-container">

                                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                {
                                    <img id="imagePreview"
                                         src="@Model.ExistingImageUrl"
                                         alt="@Model.Name"
                                         class="image-preview"
                                         onerror="this.onerror=null;this.src='@placeholder';" />
                                }
                                else
                                {
                                    <div id="noImage"
                                         class="no-image">

                                        <i class="bi bi-image"></i>

                                        <span>
                                            No image available
                                        </span>

                                    </div>

                                    <img id="imagePreview"
                                         class="image-preview d-none"
                                         alt="Product Preview" />
                                }

                            </div>


                            <!-- File Input -->

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ImageFile"
                                   id="ImageFile"
                                   type="file"
                                   class="form-control file-input"
                                   accept="image/png,image/jpeg,image/gif,image/webp" />


                            <small class="image-help">

                                <i class="bi bi-info-circle"></i>

                                Leave empty to keep the current image.
                                Supported formats: JPG, PNG, GIF, WEBP.

                            </small>

                            <span asp-validation-for="ImageFile"
                                  class="text-danger small d-block mt-2">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================
                     Form Footer
                     ================================= -->

                <div class="form-footer">

                    <div class="footer-info">

                        <i class="bi bi-shield-check"></i>

                        Make sure all product information is correct.

                    </div>


                    <div class="form-actions">

                        <a asp-action="Index"
                           class="btn btn-cancel">

                            <i class="bi bi-x-lg"></i>

                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-save">

                            <i class="bi bi-check-circle"></i>

                            Save Changes

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


</div>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const imageInput = document.getElementById("ImageFile");
        const imagePreview = document.getElementById("imagePreview");
        const noImage = document.getElementById("noImage");

        if (!imageInput) {
            return;
        }

        imageInput.addEventListener("change", function () {

            const file = this.files && this.files[0];

            if (!file) {
                return;
            }

            if (!file.type.startsWith("image/")) {
                return;
            }

            const imageUrl = URL.createObjectURL(file);

            if (imagePreview) {

                imagePreview.src = imageUrl;

                imagePreview.classList.remove("d-none");

            }

            if (noImage) {

                noImage.classList.add("d-none");

            }

        });

    });

</script>

}
