
@model Graduation_Project_ITI.Models.SellerAnalysisVM

@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";

    ViewData["Title"] = "Analytics";

    string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "pending" => "status-pending",
            "confirmed" => "status-confirmed",
            "shipped" => "status-shipped",
            "delivered" => "status-delivered",
            "cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }

    var isSalesUp = Model.SalesGrowthPercentage >= 0;
    var isOrdersUp = Model.OrdersGrowthPercentage >= 0;

    var maxProductSales = Model.TopProducts.Any()
        ? Model.TopProducts.Max(x => x.Sales)
        : 0;

    var maxCategorySales = Model.CategorySales.Any()
        ? Model.CategorySales.Max(x => x.Sales)
        : 0;
}

<div class="analytics-page">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="analytics-header">

        <div>

            <div class="analytics-kicker">
                <i class="bi bi-bar-chart-line-fill"></i>
                Seller Analytics
            </div>

            <h1>
                Business Overview
            </h1>

            <p>
                Monitor your sales performance, orders and products.
            </p>

        </div>

        <div class="header-actions">

             
            <a asp-action="Index"
               class="header-btn secondary">
                <i class="bi bi-box-seam"></i>
                Products
            </a>

            <a asp-action="Orders"
               class="header-btn primary">
                <i class="bi bi-bag-check"></i>
                Orders
            </a>
        </div>

    </div>


    <!-- ================================================= -->
    <!-- SELLER -->
    <!-- ================================================= -->

    <div class="seller-profile">

        <div class="seller-avatar">
            <i class="bi bi-shop"></i>
        </div>

        <div class="seller-profile-info">

            <span>
                STORE
            </span>

            <h3>
                @Model.SellerName
            </h3>

        </div>

        <div class="seller-profile-stat">

            <strong>
                @Model.TotalProducts
            </strong>

            <span>
                Products
            </span>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- KPI CARDS -->
    <!-- ================================================= -->

    <div class="kpi-grid">

        <!-- Sales -->

        <div class="kpi-card">

            <div class="kpi-top">

                <div class="kpi-icon sales">
                    <i class="bi bi-currency-exchange"></i>
                </div>

                @if (Model.SalesGrowthPercentage != 0)
                {
                    <span class="growth @(isSalesUp ? "positive" : "negative")">

                        <i class="bi @(isSalesUp
                            ? "bi-arrow-up"
                            : "bi-arrow-down")"></i>

                        @Math.Abs(Model.SalesGrowthPercentage).ToString("0.0")%

                    </span>
                }

            </div>

            <span class="kpi-label">
                Total Sales
            </span>

            <h2>
                EGP @Model.TotalSales.ToString("N2")
            </h2>

            <small>
                Compared with previous 30 days
            </small>

        </div>


        <!-- Orders -->

        <div class="kpi-card">

            <div class="kpi-top">

                <div class="kpi-icon orders">
                    <i class="bi bi-bag-check"></i>
                </div>

                @if (Model.OrdersGrowthPercentage != 0)
                {
                    <span class="growth @(isOrdersUp ? "positive" : "negative")">

                        <i class="bi @(isOrdersUp
                            ? "bi-arrow-up"
                            : "bi-arrow-down")"></i>

                        @Math.Abs(Model.OrdersGrowthPercentage).ToString("0.0")%

                    </span>
                }

            </div>

            <span class="kpi-label">
                Total Orders
            </span>

            <h2>
                @Model.TotalOrders
            </h2>

            <small>
                Orders containing your products
            </small>

        </div>


        <!-- Products Sold -->

        <div class="kpi-card">

            <div class="kpi-top">

                <div class="kpi-icon products">
                    <i class="bi bi-box-seam"></i>
                </div>

            </div>

            <span class="kpi-label">
                Products Sold
            </span>

            <h2>
                @Model.TotalProductsSold
            </h2>

            <small>
                Total units sold
            </small>

        </div>


        <!-- Average Order -->

        <div class="kpi-card">

            <div class="kpi-top">

                <div class="kpi-icon average">
                    <i class="bi bi-receipt"></i>
                </div>

            </div>

            <span class="kpi-label">
                Average Order
            </span>

            <h2>
                EGP @Model.AverageOrderValue.ToString("N2")
            </h2>

            <small>
                Average seller order value
            </small>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- CHART + STATUS -->
    <!-- ================================================= -->

    <div class="dashboard-grid">

        <!-- SALES TREND -->

        <div class="dashboard-card trend-card">

            <div class="dashboard-card-header">

                <div>

                    <span class="card-label">
                        PERFORMANCE
                    </span>

                    <h3>
                        Sales & Orders
                    </h3>

                    <p>
                        Last 30 days performance
                    </p>

                </div>

                <div class="trend-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

            </div>

            <div class="chart-wrapper">
                <canvas id="salesTrendChart"></canvas>
            </div>

        </div>


        <!-- ORDER STATUS -->

        <div class="dashboard-card">

            <div class="dashboard-card-header">

                <div>

                    <span class="card-label">
                        ORDERS
                    </span>

                    <h3>
                        Order Status
                    </h3>

                    <p>
                        Current order distribution
                    </p>

                </div>

                <i class="bi bi-pie-chart-fill card-header-icon"></i>

            </div>


            <div class="status-chart-container">

                <div class="status-doughnut">

                    <canvas id="orderStatusChart"></canvas>

                </div>

                <div class="status-legend">

                    <div class="legend-item">
                        <span class="legend-color pending"></span>
                        <span>Pending</span>
                        <strong>@Model.PendingOrders</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-color confirmed"></span>
                        <span>Confirmed</span>
                        <strong>@Model.ConfirmedOrders</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-color shipped"></span>
                        <span>Shipped</span>
                        <strong>@Model.ShippedOrders</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-color delivered"></span>
                        <span>Delivered</span>
                        <strong>@Model.CompletedOrders</strong>
                    </div>

                    <div class="legend-item">
                        <span class="legend-color cancelled"></span>
                        <span>Cancelled</span>
                        <strong>@Model.CancelledOrders</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- TOP PRODUCTS + RATINGS -->
    <!-- ================================================= -->

    <div class="dashboard-grid">

        <!-- TOP PRODUCTS -->

        <div class="dashboard-card">

            <div class="dashboard-card-header">

                <div>

                    <span class="card-label">
                        PRODUCTS
                    </span>

                    <h3>
                        Top 3 Best Sellers
                    </h3>

                    <p>
                        Your best performing products
                    </p>

                </div>

                <i class="bi bi-trophy-fill card-header-icon"></i>

            </div>


            @if (!Model.TopProducts.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-box"></i>
                    <p>No sales data available.</p>
                </div>
            }
            else
            {
                <div class="top-products">

                    @{
                        var rank = 0;
                    }

                    @foreach (var product in Model.TopProducts)
                    {
                        rank++;

                        var percentage = maxProductSales > 0
                            ? (product.Sales / maxProductSales) * 100
                            : 0;

                        <div class="top-product">

                            <div class="rank">
                                @rank
                            </div>

                            <div class="top-product-image">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.ProductName"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="image-fallback">
                                        <i class="bi bi-box"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="image-fallback show">
                                        <i class="bi bi-box"></i>
                                    </div>
                                }

                            </div>

                            <div class="top-product-info">

                                <strong>
                                    @product.ProductName
                                </strong>

                                <span>
                                    @product.QuantitySold units sold
                                </span>

                                <div class="mini-progress">
                                    <div style="width:@percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>

                            </div>

                            <div class="top-product-sales">

                                <strong>
                                    EGP @product.Sales.ToString("N0")
                                </strong>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>


        <!-- RATINGS -->

        <div class="dashboard-card">

            <div class="dashboard-card-header">

                <div>

                    <span class="card-label">
                        CUSTOMER FEEDBACK
                    </span>

                    <h3>
                        Product Ratings
                    </h3>

                    <p>
                        Customer satisfaction
                    </p>

                </div>

                <i class="bi bi-star-fill card-header-icon rating-icon"></i>

            </div>


            <div class="rating-summary">

                <div class="rating-score">

                    <strong>
                        @Model.AverageRating.ToString("0.0")
                    </strong>

                    <div class="stars">
                        ★★★★★
                    </div>

                    <span>
                        @Model.TotalReviews reviews
                    </span>

                </div>

            </div>


            @if (!Model.ProductRatings.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-star"></i>
                    <p>No product reviews yet.</p>
                </div>
            }
            else
            {
                <div class="rating-products">

                    @foreach (var product in Model.ProductRatings.Take(4))
                    {
                        <div class="rating-product">

                            <div class="rating-product-image">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.ProductName" />
                                }
                                else
                                {
                                    <i class="bi bi-box"></i>
                                }

                            </div>

                            <div class="rating-product-info">

                                <strong>
                                    @product.ProductName
                                </strong>

                                <span>
                                    @product.ReviewCount reviews
                                </span>

                            </div>

                            <div class="product-rating">

                                <span>
                                    ★
                                </span>

                                <strong>
                                    @product.AverageRating.ToString("0.0")
                                </strong>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>


    <!-- ================================================= -->
    <!-- CATEGORY ANALYTICS -->
    <!-- ================================================= -->

    <div class="dashboard-card category-card">

        <div class="dashboard-card-header">

            <div>

                <span class="card-label">
                    CATEGORIES
                </span>

                <h3>
                    Sales by Category
                </h3>

                <p>
                    Revenue distribution across your categories
                </p>

            </div>

            <i class="bi bi-bar-chart-fill card-header-icon"></i>

        </div>


        <div class="category-layout">

            <div class="category-chart">

                <canvas id="categoryChart"></canvas>

            </div>


            <div class="category-list">

                @if (!Model.CategorySales.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-bar-chart"></i>
                        <p>No category sales available.</p>
                    </div>
                }
                else
                {
                    @foreach (var category in Model.CategorySales)
                    {
                        var percentage = maxCategorySales > 0
                            ? (category.Sales / maxCategorySales) * 100
                            : 0;

                        <div class="category-row">

                            <div class="category-row-top">

                                <strong>
                                    @category.CategoryName
                                </strong>

                                <span>
                                    EGP @category.Sales.ToString("N0")
                                </span>

                            </div>

                            <div class="category-progress">

                                <div style="width:@percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>

                            </div>

                            <small>
                                @category.QuantitySold units sold
                            </small>

                        </div>
                    }
                }

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- RECENT ORDERS -->
    <!-- ================================================= -->

    <div class="dashboard-card recent-orders">

        <div class="dashboard-card-header">

            <div>

                <span class="card-label">
                    ORDERS
                </span>

                <h3>
                    Recent Orders
                </h3>

                <p>
                    Latest orders containing your products
                </p>

            </div>

            <a asp-action="Orders"
               class="view-all">

                View All

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        @if (!Model.RecentOrders.Any())
        {
            <div class="empty-state">
                <i class="bi bi-bag"></i>
                <p>No orders available.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="analytics-table">

                    <thead>

                        <tr>

                            <th>ORDER</th>

                            <th>CUSTOMER</th>

                            <th>DATE</th>

                            <th>ITEMS</th>

                            <th>TOTAL</th>

                            <th>STATUS</th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>

                                <td>

                                    <span class="order-id">
                                        #@order.OrderId.ToString()[..8]
                                    </span>

                                </td>

                                <td>

                                    <strong>
                                        @order.CustomerName
                                    </strong>

                                </td>

                                <td>

                                    <span class="muted">
                                        @order.OrderDate.ToString("MMM dd, yyyy")
                                    </span>

                                </td>

                                <td>

                                    <span class="item-count">
                                        @order.ItemsCount
                                    </span>

                                </td>

                                <td>

                                    <strong>
                                        EGP @order.Total.ToString("N2")
                                    </strong>

                                </td>

                                <td>

                                    <span class="status-badge @GetStatusClass(order.Status)">

                                        <span class="status-dot"></span>

                                        @order.Status

                                    </span>

                                </td>

                                <td>

                                    <a asp-action="OrderDetails"
                                       asp-route-id="@order.OrderId"
                                       class="details-button">

                                        <i class="bi bi-arrow-up-right"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- ===================================================== -->
<!-- CHART.JS -->
<!-- ===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    const trendLabels =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels));

    const salesData =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend));

    const ordersData =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrdersTrend));


    // =====================================================
    // SALES & ORDERS CHART
    // =====================================================

    const salesTrendCanvas =
        document.getElementById('salesTrendChart');

    if (salesTrendCanvas) {

        new Chart(salesTrendCanvas, {

            type: 'line',

            data: {

                labels: trendLabels,

                datasets: [

                    {
                        label: 'Sales',

                        data: salesData,

                        borderWidth: 3,

                        tension: 0.4,

                        fill: true,

                        yAxisID: 'salesAxis'
                    },

                    {
                        label: 'Orders',

                        data: ordersData,

                        borderWidth: 3,

                        tension: 0.4,

                        fill: false,

                        yAxisID: 'ordersAxis'
                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    mode: 'index',
                    intersect: false
                },

                plugins: {

                    legend: {
                        position: 'top',
                        align: 'end'
                    }

                },

                scales: {

                    salesAxis: {

                        position: 'left',

                        beginAtZero: true,

                        grid: {
                            color: '#eef1f5'
                        },

                        ticks: {

                            callback: function(value) {
                                return 'EGP ' + value;
                            }

                        }

                    },

                    ordersAxis: {

                        position: 'right',

                        beginAtZero: true,

                        grid: {
                            drawOnChartArea: false
                        }

                    }

                }

            }

        });

    }


    // =====================================================
    // ORDER STATUS CHART
    // =====================================================

    const orderStatusCanvas =
        document.getElementById('orderStatusChart');

    if (orderStatusCanvas) {

        new Chart(orderStatusCanvas, {

            type: 'doughnut',

            data: {

                labels: [
                    'Pending',
                    'Confirmed',
                    'Shipped',
                    'Delivered',
                    'Cancelled'
                ],

                datasets: [{

                    data: [
                        @Model.PendingOrders,
                        @Model.ConfirmedOrders,
                        @Model.ShippedOrders,
                        @Model.CompletedOrders,
                        @Model.CancelledOrders
                    ],

                    borderWidth: 0,

                    cutout: '72%'

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    }

                }

            }

        });

    }


    // =====================================================
    // CATEGORY CHART
    // =====================================================

    const categoryCanvas =
        document.getElementById('categoryChart');

    if (categoryCanvas) {

        new Chart(categoryCanvas, {

            type: 'doughnut',

            data: {

                labels: @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        Model.CategorySales.Select(x => x.CategoryName)
                    )
                ),

                datasets: [{

                    data: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            Model.CategorySales.Select(x => x.Sales)
                        )
                    ),

                    borderWidth: 3,

                    borderColor: '#ffffff',

                    cutout: '65%'

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        position: 'bottom'
                    }

                }

            }

        });

    }

</script>


<style>

    /* ================================================= */
    /* PAGE */
    /* ================================================= */

    .analytics-page {

        min-height: 100vh;

        padding: 32px;

        background: #f7f8fc;

        color: #172033;

    }


    /* ================================================= */
    /* HEADER */
    /* ================================================= */

    .analytics-header {

        display: flex;

        justify-content: space-between;

        align-items: flex-end;

        margin-bottom: 26px;

    }

    .analytics-kicker {

        color: #6366f1;

        font-size: 12px;

        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: .12em;

        margin-bottom: 7px;

    }

    .analytics-header h1 {

        margin: 0;

        font-size: 32px;

        font-weight: 850;

    }

    .analytics-header p {

        margin: 7px 0 0;

        color: #8b93a5;

        font-size: 14px;

    }


    .header-actions {

        display: flex;

        gap: 10px;

    }

    .header-btn {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        padding: 11px 17px;

        border-radius: 11px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 700;

        transition: .2s;

    }

    .header-btn.primary {

        background: #111827;

        color: white;

    }

    .header-btn.secondary {

        background: white;

        color: #374151;

        border: 1px solid #e5e7eb;

    }


    /* ================================================= */
    /* SELLER */
    /* ================================================= */

    .seller-profile {

        background: white;

        border: 1px solid #e8ebf2;

        border-radius: 18px;

        padding: 18px 22px;

        display: flex;

        align-items: center;

        gap: 15px;

        margin-bottom: 22px;

    }

    .seller-avatar {

        width: 52px;

        height: 52px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 14px;

        background: #eef2ff;

        color: #4f46e5;

        font-size: 23px;

    }

    .seller-profile-info {

        flex: 1;

    }

    .seller-profile-info span {

        font-size: 10px;

        color: #9aa2b1;

        font-weight: 800;

        letter-spacing: .1em;

    }

    .seller-profile-info h3 {

        margin: 3px 0 0;

        font-size: 18px;

        font-weight: 800;

    }

    .seller-profile-stat {

        text-align: right;

        padding-left: 25px;

        border-left: 1px solid #edf0f4;

    }

    .seller-profile-stat strong {

        display: block;

        font-size: 20px;

    }

    .seller-profile-stat span {

        color: #929aaa;

        font-size: 11px;

    }


    /* ================================================= */
    /* KPI */
    /* ================================================= */

    .kpi-grid {

        display: grid;

        grid-template-columns: repeat(4, 1fr);

        gap: 16px;

        margin-bottom: 20px;

    }

    .kpi-card {

        background: white;

        border: 1px solid #e8ebf2;

        border-radius: 17px;

        padding: 20px;

        transition: .2s;

    }

    .kpi-card:hover {

        transform: translateY(-3px);

        box-shadow: 0 15px 35px rgba(30,41,59,.07);

    }

    .kpi-top {

        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 18px;

    }

    .kpi-icon {

        width: 42px;

        height: 42px;

        border-radius: 12px;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 19px;

    }

    .kpi-icon.sales {

        background: #ecfdf5;

        color: #059669;

    }

    .kpi-icon.orders {

        background: #eff6ff;

        color: #2563eb;

    }

    .kpi-icon.products {

        background: #faf5ff;

        color: #9333ea;

    }

    .kpi-icon.average {

        background: #fff7ed;

        color: #ea580c;

    }

    .growth {

        display: inline-flex;

        align-items: center;

        gap: 3px;

        font-size: 11px;

        font-weight: 800;

        padding: 5px 8px;

        border-radius: 7px;

    }

    .growth.positive {

        color: #047857;

        background: #ecfdf5;

    }

    .growth.negative {

        color: #b91c1c;

        background: #fef2f2;

    }

    .kpi-label {

        color: #8b93a5;

        font-size: 12px;

        display: block;

    }

    .kpi-card h2 {

        margin: 5px 0;

        font-size: 25px;

        font-weight: 850;

    }

    .kpi-card small {

        color: #a1a8b5;

        font-size: 10px;

    }


    /* ================================================= */
    /* DASHBOARD GRID */
    /* ================================================= */

    .dashboard-grid {

        display: grid;

        grid-template-columns: 1.5fr 1fr;

        gap: 18px;

        margin-bottom: 18px;

    }

    .dashboard-card {

        background: white;

        border: 1px solid #e8ebf2;

        border-radius: 18px;

        padding: 22px;

        min-width: 0;

    }

    .dashboard-card-header {

