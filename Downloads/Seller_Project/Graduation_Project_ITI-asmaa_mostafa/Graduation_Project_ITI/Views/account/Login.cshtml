
@model Graduation_Project_ITI.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: linear-gradient(135deg, #f5f7fb 0%, #eef2f7 100%);
    }

    .login-card {
        width: 100%;
        max-width: 1000px;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.10);
        display: flex;
    }

    /* Left Side */
    .login-info {
        width: 45%;
        background: linear-gradient(145deg, #0d6efd, #084298);
        color: white;
        padding: 55px 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .login-info::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        top: -110px;
        right: -100px;
    }

    .login-info::after {
        content: "";
        position: absolute;
        width: 190px;
        height: 190px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        bottom: -80px;
        left: -70px;
    }

    .brand-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 25px;
        position: relative;
        z-index: 1;
    }

    .login-info h1 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 15px;
        position: relative;
        z-index: 1;
    }

    .login-info p {
        font-size: 16px;
        line-height: 1.8;
        opacity: 0.9;
        position: relative;
        z-index: 1;
    }

    .feature-list {
        margin-top: 30px;
        padding: 0;
        list-style: none;
        position: relative;
        z-index: 1;
    }

    .feature-list li {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        font-size: 15px;
    }

    .feature-list i {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }

    /* Right Side */
    .login-form-container {
        width: 55%;
        padding: 55px 50px;
    }

    .form-header {
        margin-bottom: 30px;
    }

    .form-header h2 {
        font-size: 30px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 8px;
    }

    .form-header p {
        color: #6c757d;
        margin: 0;
    }

    .input-group-custom {
        position: relative;
        margin-bottom: 22px;
    }

    .input-label {
        font-weight: 600;
        font-size: 14px;
        color: #343a40;
        margin-bottom: 8px;
        display: block;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        bottom: 16px;
        color: #8a94a6;
        z-index: 5;
    }

    .input-group-custom .form-control {
        height: 52px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding-left: 45px;
        transition: all 0.2s ease;
    }

    .input-group-custom .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.10);
    }

    /* Button */
    .login-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        color: white;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.2s ease;
        box-shadow: 0 7px 18px rgba(13, 110, 253, 0.22);
    }

    .login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.30);
    }

    .register-link {
        text-align: center;
        margin-top: 22px;
        color: #6c757d;
        font-size: 14px;
    }

    .register-link a {
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
    }

    .register-link a:hover {
        text-decoration: underline;
    }

    .validation-message {
        font-size: 13px;
        margin-top: 5px;
    }

    /* Responsive */
    @@media (max-width: 850px) {

        .login-card {
            flex-direction: column;
        }

        .login-info,
        .login-form-container {
            width: 100%;
        }

        .login-info {
            padding: 40px 30px;
        }

        .login-info h1 {
            font-size: 28px;
        }

        .feature-list {
            display: none;
        }

        .login-form-container {
            padding: 35px 25px;
        }
    }

    @@media (max-width: 550px) {

        .login-page {
            padding: 20px 10px;
        }

        .login-info {
            padding: 30px 25px;
        }

        .login-form-container {
            padding: 30px 20px;
        }
    }
</style>


<div class="login-page">

    <div class="login-card">

        <!-- Left Side -->
        <div class="login-info">

            <div class="brand-icon">
                <i class="bi bi-shop"></i>
            </div>

            <h1>Welcome Back!</h1>

            <p>
                Sign in to your account and continue
                your shopping journey with us.
            </p>

            <ul class="feature-list">

                <li>
                    <i class="bi bi-check-lg"></i>
                    Browse and discover products
                </li>

                <li>
                    <i class="bi bi-check-lg"></i>
                    Manage your orders
                </li>

                <li>
                    <i class="bi bi-check-lg"></i>
                    Save your favorite products
                </li>

                <li>
                    <i class="bi bi-check-lg"></i>
                    Enjoy a secure shopping experience
                </li>

            </ul>

        </div>


        <!-- Right Side -->
        <div class="login-form-container">

            <div class="form-header">

                <h2>Login</h2>

                <p>
                    Enter your account details to continue.
                </p>

            </div>


            <form asp-action="Login" method="post">

                <div asp-validation-summary="All"
                     class="text-danger validation-message mb-3">
                </div>


                <!-- Email -->
                <div class="input-group-custom">

                    <label asp-for="Email"
                           class="input-label">
                        Email Address
                    </label>

                    <i class="bi bi-envelope input-icon"></i>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="example@email.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger validation-message">
                    </span>

                </div>


                <!-- Password -->
                <div class="input-group-custom">

                    <label asp-for="Password"
                           class="input-label">
                        Password
                    </label>

                    <i class="bi bi-lock input-icon"></i>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="text-danger validation-message">
                    </span>

                </div>


                <!-- Login Button -->
                <button type="submit"
                        class="login-btn">

                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Login

                </button>


                <!-- Register -->
                <div class="register-link">

                    Don't have an account?

                    <a asp-controller="Account"
                       asp-action="Register">
                        Create one
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
