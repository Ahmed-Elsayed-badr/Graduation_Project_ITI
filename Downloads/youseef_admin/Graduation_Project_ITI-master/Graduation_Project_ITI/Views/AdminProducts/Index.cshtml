@model List<Graduation_Project_ITI.Models.Admin.AdminProductViewModel>

@{
    ViewData["Title"] = "Products";
}

<h2 class="mb-3">Products</h2>

@if (TempData["AdminSuccess"] != null)
{
    <div class="alert alert-success">@TempData["AdminSuccess"]</div>
}
@if (TempData["AdminError"] != null)
{
    <div class="alert alert-danger">@TempData["AdminError"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Seller</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Reviews</th>
                    <th>In Orders</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <img src="@product.ImageUrl" alt="@product.Name"
                                 style="width: 48px; height: 48px; object-fit: cover;"
                                 onerror="this.style.display='none'" />
                        </td>
                        <td title="@product.Description">@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td>
                            @product.SellerName
                            @if (!string.IsNullOrWhiteSpace(product.ShopName))
                            {
                                <div class="text-muted small">@product.ShopName</div>
                            }
                        </td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            @if (product.AvailableQuantity > 0)
                            {
                                @product.AvailableQuantity
                            }
                            else
                            {
                                <span class="text-danger">Out of stock</span>
                            }
                        </td>
                        <td>@product.ReviewsCount</td>
                        <td>@product.OrdersCount</td>
                        <td class="text-end">
                            @if (product.CanBeRemoved)
                            {
                                <form asp-action="Remove" asp-route-id="@product.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this product permanently? It will also be removed from carts and wishlists.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="This product exists in previous orders and cannot be removed.">
                                    Remove
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}