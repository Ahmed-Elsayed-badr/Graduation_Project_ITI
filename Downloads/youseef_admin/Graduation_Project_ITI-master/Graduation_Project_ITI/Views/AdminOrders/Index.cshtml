@model List<Graduation_Project_ITI.Models.Admin.AdminOrderViewModel>

@{
    ViewData["Title"] = "Orders";

    string StatusBadge(string status) => status?.ToLower() switch
    {
        "pending" => "bg-warning text-dark",
        "confirmed" => "bg-info text-dark",
        "shipped" => "bg-primary",
        "delivered" => "bg-success",
        "cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<h2 class="mb-3">Orders</h2>

@if (TempData["AdminSuccess"] != null)
{
    <div class="alert alert-success">@TempData["AdminSuccess"]</div>
}
@if (TempData["AdminError"] != null)
{
    <div class="alert alert-danger">@TempData["AdminError"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No orders found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="text-muted small">@order.Id.ToString().Substring(0, 8)</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @order.CustomerName
                            <div class="text-muted small">@order.CustomerEmail</div>
                        </td>
                        <td>@order.ItemsCount</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td><span class="badge @StatusBadge(order.Status)">@order.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}