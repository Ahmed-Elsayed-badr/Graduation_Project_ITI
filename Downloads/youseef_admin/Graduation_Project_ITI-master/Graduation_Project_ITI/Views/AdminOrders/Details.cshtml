@model Graduation_Project_ITI.Models.Admin.AdminOrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";

    string StatusBadge(string status) => status?.ToLower() switch
    {
        "pending" => "bg-warning text-dark",
        "confirmed" => "bg-info text-dark",
        "shipped" => "bg-primary",
        "delivered" => "bg-success",
        "cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Order Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Orders</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Order</div>
            <div class="card-body">
                <p class="mb-1"><strong>Order ID:</strong> <span class="text-muted small">@Model.Id</span></p>
                <p class="mb-1"><strong>Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
                <p class="mb-1"><strong>Status:</strong> <span class="badge @StatusBadge(Model.Status)">@Model.Status</span></p>
                <p class="mb-0"><strong>Total:</strong> @Model.TotalAmount.ToString("C")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Customer</div>
            <div class="card-body">
                <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                <p class="mb-0"><strong>Phone:</strong> @(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "-" : Model.CustomerPhone)</p>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3">Items</h5>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">This order has no items.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Product</th>
                    <th>Seller</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th class="text-end">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl" alt="@item.ProductName"
                                 style="width: 48px; height: 48px; object-fit: cover;"
                                 onerror="this.style.display='none'" />
                        </td>
                        <td>@item.ProductName</td>
                        <td>
                            @item.SellerName
                            @if (!string.IsNullOrWhiteSpace(item.ShopName))
                            {
                                <div class="text-muted small">@item.ShopName</div>
                            }
                        </td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td class="text-end">@item.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">Total</th>
                    <th class="text-end">@Model.TotalAmount.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
}