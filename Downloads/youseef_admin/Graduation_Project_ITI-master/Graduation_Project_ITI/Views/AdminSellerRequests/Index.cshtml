@model List<Graduation_Project_ITI.Models.Admin.AdminSellerRequestViewModel>

@{
    ViewData["Title"] = "Seller Requests";
}

<h2 class="mb-3">Seller Requests</h2>

@if (TempData["AdminSuccess"] != null)
{
    <div class="alert alert-success">@TempData["AdminSuccess"]</div>
}
@if (TempData["AdminError"] != null)
{
    <div class="alert alert-danger">@TempData["AdminError"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">There are no seller requests.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Shop Name</th>
                    <th>Requested</th>
                    <th>Reviewed</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.UserName</td>
                        <td>@request.UserEmail</td>
                        <td>@(string.IsNullOrWhiteSpace(request.ShopName) ? "-" : request.ShopName)</td>
                        <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(request.HasBeenReviewed ? request.ReviewedAt.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                        <td>
                            @if (request.IsPending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (string.Equals(request.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@request.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (request.IsPending)
                            {
                                <form asp-action="Approve" asp-route-id="@request.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@request.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Reject this seller request?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}