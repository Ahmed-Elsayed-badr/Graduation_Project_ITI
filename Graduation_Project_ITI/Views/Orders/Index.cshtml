@model List<Graduation_Project_ITI.Models.OrderListViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<h2>My Orders</h2>

@if (!Model.Any())
{
    <p>You haven't placed any orders yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Order Date</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                    <td>@order.ItemsCount</td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        <span class="badge bg-@(order.Status == "Pending" ? "warning" : order.Status == "Cancelled" ? "secondary" : "success")">
                            @order.Status
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
