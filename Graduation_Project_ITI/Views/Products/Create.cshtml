@model Graduation_Project_ITI.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle text-success"></i> Add New Product</h4>
                <p class="text-muted small mb-0">Fill in the product details below</p>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" asp-for="SellerId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" placeholder="Product name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the product (at least 20 characters)..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Price" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="Price" class="form-control" placeholder="0.00" />
                                        <span class="input-group-text">EGP</span>
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="AvailableQuantity" class="form-label fw-semibold"></label>
                                    <input asp-for="AvailableQuantity" class="form-control" placeholder="0" />
                                    <span asp-validation-for="AvailableQuantity" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                            <div class="border rounded p-3 text-center bg-light">
                                <img id="imagePreview" class="img-fluid rounded mb-2 image-preview d-none" alt="Preview" />
                                <i id="imageIcon" class="bi bi-image text-muted d-block" style="font-size:2rem;"></i>
                                <input asp-for="ImageFile" type="file" class="form-control mt-2" accept="image/png,image/jpeg,image/gif,image/webp" />
                                <small class="text-muted d-block mt-1">JPG, PNG, GIF or WEBP - max 5 MB</small>
                                <span asp-validation-for="ImageFile" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle"></i> Save Product
                        </button>
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live preview of the selected image
        document.getElementById('ImageFile').addEventListener('change', function () {
            var file = this.files && this.files[0];
            var preview = document.getElementById('imagePreview');
            var icon = document.getElementById('imageIcon');
            if (!file) { preview.classList.add('d-none'); icon.classList.remove('d-none'); return; }
            preview.src = URL.createObjectURL(file);
            preview.classList.remove('d-none');
            icon.classList.add('d-none');
        });
    </script>
}
