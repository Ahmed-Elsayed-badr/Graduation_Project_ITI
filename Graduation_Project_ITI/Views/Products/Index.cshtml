@model IEnumerable<DAL.Product>
@{
    ViewData["Title"] = "Products";
    var placeholder = Url.Content("~/images/placeholder.png");
    string? searchTerm = ViewBag.SearchTerm;
    bool? sortAscending = ViewBag.SortAscending;
    var hasFilters = !string.IsNullOrWhiteSpace(searchTerm) || sortAscending.HasValue || !string.IsNullOrEmpty(Context.Request.Query["categoryId"]);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0 page-title"><i class="bi bi-box-seam"></i> Products</h2>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle"></i> Add New Product
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Search</label>
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search products..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Category</label>
                @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "All Categories", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Sort by Price</label>
                <select name="sortAscending" class="form-select">
                    <option value="">No Sort</option>
                    <option value="true" selected="@(sortAscending == true)">Low to High</option>
                    <option value="false" selected="@(sortAscending == false)">High to Low</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-light border" title="Clear filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size:2.5rem;"></i>
        <p class="mt-2">No products found.</p>
    </div>
}
else
{
    <p class="text-muted small mb-3">@Model.Count() product(s)</p>
}

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0 product-card">
                <div class="product-image">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
                         onerror="this.onerror=null;this.src='@placeholder'" />
                </div>
                <div class="card-body d-flex flex-column">
                    <h6 class="fw-bold mb-1 text-truncate" title="@item.Name">@item.Name</h6>
                    <span class="badge bg-light text-dark border mb-2 align-self-start">@(item.Category?.Name ?? "Uncategorized")</span>
                    <p class="text-primary fw-bold mb-2">@item.Price.ToString("N2") EGP</p>
                    <div class="mb-3">
                        @if (item.AvailableQuantity <= 0)
                        {
                            <span class="badge text-bg-danger">Out of stock</span>
                        }
                        else if (item.AvailableQuantity <= 5)
                        {
                            <span class="badge text-bg-warning">Only @item.AvailableQuantity left</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">In stock: @item.AvailableQuantity</span>
                        }
                    </div>
                    <div class="mt-auto d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary flex-fill" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-fill" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger flex-fill" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
