@model DAL.Category
@{
    ViewData["Title"] = Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="fw-bold"><i class="bi bi-tag text-primary"></i> @Model.Name</h4>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Description</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Comment) ? "—" : Model.Comment)</dd>

                    <dt class="col-sm-3 text-muted">Created</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                </dl>
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-light border">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.Id" class="btn btn-outline-primary">
                        <i class="bi bi-box-seam"></i> View Products
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
