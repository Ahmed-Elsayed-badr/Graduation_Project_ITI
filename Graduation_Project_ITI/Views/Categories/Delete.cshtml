@model DAL.Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:2.5rem;"></i>
                <h4 class="fw-bold mt-3">Delete Category?</h4>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 text-start"></div>
                <p class="text-muted">
                    Are you sure you want to delete
                    <strong>"@Model.Name"</strong>? This action cannot be undone.
                </p>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2 mt-3">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash"></i> Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
